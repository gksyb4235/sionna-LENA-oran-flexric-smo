GRAFANA_URL=http://localhost:3000
GRAFANA_API_KEY=
GRAFANA_PROMETHEUS_DATASOURCE_UID=prometheus-prod
GRAFANA_INFLUXDB_DATASOURCE_UID=RAN-KPM-InfluxDB
GRAFANA_INFLUXDB_DATABASE=ran_kpm
GRAFANA_TIMEOUT_SEC=20
GRAFANA_CPU_METRIC=nf_cpu_usage_percent
GRAFANA_NF_LABEL=nf
GRAFANA_CPU_PROMQL_TEMPLATE=avg_over_time({metric_name}{label_selector}[{window}])
MONITORING_WINDOW_SECONDS=60
OPENAI_MODEL=openai:gpt-5.4-mini
OPENAI_API_KEY=
PROBE_AGENT_TIMEOUT_SEC=240
