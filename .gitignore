# Ignore local cache used by e.g. clangd
.cache/

# Regeneratable Sionna RT lookup-table cache (large binary, ~2.5GB)
scenarios/khu-real/sionna_rt_cache.h5
scenarios/khu-real/sionna_rt_cache_lzf.h5

# Per-cell RET caches assembled on demand from ret_caches/tilt_*deg/ groups
# (pure HDF5 copy, no ray tracing -- see build_merged_ret_cache.py)
scenarios/khu-real/ret_caches/merged_percell/

# Timestamped simulation results are runtime artifacts; keep only their schema docs.
scenarios/results/*/
!scenarios/results/KPI_SCHEMA.md

# ASan debug build (regenerate with ./ns3 configure --enable-asan if needed)
build-asan/

# Test/lint caches
.hypothesis/
.pytest_cache/
.ruff_cache/

# Runtime state/telemetry logs (not source)
.state/

# MongoDB runtime binaries and live DB data for smo/agentic_ai (not source,
# not portable, and exceeds GitHub's per-file size limit)
smo/agentic_ai/mongodb/current/
smo/agentic_ai/mongodb/mongodb-linux-*/
smo/agentic_ai/mongodb/downloads/
smo/agentic_ai/mongodb/standalone-data/
smo/agentic_ai/mongodb/logs/
smo/agentic_ai/mongodb/run/


# AGORA runtime logs, SQLite state, simulation outputs, and migration backups.

# Replay observations stay local; checkpoint/manifest/context remain in Git.
# Export/import with scripts/agora_replay.py for another checkout.
/smo/agentic_ai/agora_offline/runtime/assets/runs/*.npz
/smo/agentic_ai/agora_offline/runtime/assets_v16/runs/*.npz

# Independent private AGORA provider configuration.
/smo/agentic_ai/.env

# Local experiment outputs; source and frozen designs are tracked separately.
/verified_pc*.json

# Canonical KHU layout. Raw results and local configuration never belong in a
# new source checkout. Legacy compatibility symlinks may be versioned separately.
/experiment/khu/results/*
!/experiment/khu/results/KPI_SCHEMA.md
/experiment/khu/caches/ret_caches/merged_percell/
/experiment/khu/caches/sionna_rt_cache.h5
/experiment/khu/caches/sionna_rt_cache_lzf.h5
/experiment/khu/studies/**/config*.local.json
/experiment/khu/studies/**/config*.json.local
/experiment/khu/studies/conflict_scenarios_500/backend_smoke_*/
/experiment/khu/studies/agora_runtime/
/experiment/khu/studies/agora_conflict_sweep/
/experiment/khu/studies/two_switch_debug/
/experiment/khu/studies/two_switch_smoke/

# Keep the already-versioned legacy samples through the move. These exceptions
# can be removed only after approval to stop versioning the historical outputs.
!/experiment/khu/results/legacy_pooled/
/experiment/khu/results/legacy_pooled/*

