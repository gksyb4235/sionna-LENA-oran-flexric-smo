# Ignore everything by default, contrib sources are coming from other places
*

# Include specific files that should be tracked by Git
!.gitignore

# nr (5g-lena-v5.0.y + local/oran-e2-integration E2 patch) and oran-interface
# (ns3-o-ran-e2) are vendored directly into this fork rather than kept as
# separate submodules, so track them here.
!nr/
!nr/**
!oran-interface/
!oran-interface/**
