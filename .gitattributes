# Normalize source text on both Windows and WSL.
* text=auto eol=lf

# Model, replay, and scientific artifacts must remain byte-for-byte identical.
*.pt binary
*.npz binary
*.h5 binary
*.png binary
*.pdf binary

# Frozen sweep CSV byte hashes are part of the execution contract.
experiments/conflict_scenarios_500/sweep/data/*.csv -text whitespace=cr-at-eol
experiment/khu/studies/conflict_scenarios_500/sweep/data/*.csv -text whitespace=cr-at-eol
experiment/khu/studies/conflict_scenarios_reserve50/*.csv -text whitespace=cr-at-eol
experiment/khu/studies/conflict_scenarios_500/sweep/data/*.json -text whitespace=cr-at-eol
experiment/khu/studies/conflict_scenarios_reserve50/execution_manifest.json -text whitespace=cr-at-eol
